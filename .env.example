# Copy to .env, which is git-ignored, and fill in. Compose reads it for both services.

# Generated by `tfire admin-password`, which prints this whole line. The password itself is never
# stored anywhere. Leave the value empty and the admin surface stays off rather than unprotected.
TFIRE_ADMIN_PASSWORD=

# Left empty, Caddy answers on port 80 with no certificate, which is the local check. Set it to a
# hostname that resolves to this machine and Caddy obtains a certificate for it on its own.
TFIRE_DOMAIN=

# Loopback port the application is published on.
TFIRE_PORT=8000

# Owner of the mounted data directory, which the service writes into. Set both to the output of
# `id -u` and `id -g` when the directory belongs to a host user, which is the usual case.
TFIRE_UID=10001
TFIRE_GID=10001

# What the container sees under /app. Unset, it sees the packaged subset and serves the map: that
# is the deployment. Pointed at the working tree it also serves the admin actions that rebuild the
# dataset, retrain, or refetch from Earth Engine, which read the whole 4 GB build tree. Keep those
# four off a public host: they put the build tree, and a set of credentials, behind a process
# reachable from the proxy.
#
#   TFIRE_DATA_DIR=./data
#   TFIRE_MODELS_DIR=./models
#   TFIRE_REPORTS_DIR=./reports
#
# Earth Engine credentials, needed only by the two refresh actions. Written by
# `earthengine authenticate`; append the line with the path expanded, since compose does not
# expand ~ or $HOME here:
#
#   printf 'TFIRE_EE_DIR=%s\n' "$HOME/.config/earthengine" >> .env
